# Backend only. Never commit your real keys.
OPENROUTER_API_KEY=
GEMINI_API_KEY=
NVIDIA_NIM_KEY=
GROQ_API_KEY=
REGEN_PROVIDER=openrouter
REGEN_MODEL=openai/gpt-6-astra
# Optional model overrides for providers selected through REGEN_PROVIDER.
REGEN_GEMINI_MODEL=gemini-3.1-pro-preview
REGEN_NVIDIA_MODEL=moonshotai/kimi-k3
REGEN_GROQ_MODEL=openai/gpt-oss-120b
# Non-OpenRouter providers require explicit USD per-token prices to enforce budgets.
REGEN_INPUT_PRICE=
REGEN_OUTPUT_PRICE=
