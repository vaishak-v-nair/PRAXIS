# Gemini embeddings require GEMINI_API_KEY. NVIDIA embeddings require NVIDIA_API_KEY.
GEMINI_API_KEY=
CHAT_PROVIDER=groq
EMBEDDING_PROVIDER=gemini
GEMINI_MODEL=gemini-3.1-pro-preview
EMBEDDING_MODEL=models/gemini-embedding-001
# Optional fallback or primary chat providers.
NVIDIA_API_KEY=
ENABLE_NIM_FALLBACK=false
NIM_MODEL=meta/llama-3.1-8b-instruct
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_REASONING_EFFORT=low
TOP_K=4
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
REQUEST_TIMEOUT=60
MAX_ATTEMPTS=3
MAX_OUTPUT_TOKENS=4096
