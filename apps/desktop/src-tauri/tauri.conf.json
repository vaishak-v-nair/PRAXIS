{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PRAXIS",
  "version": "0.14.2",
  "identifier": "dev.praxis.desktop",
  "build": { "frontendDist": "../ui" },
  "app": {
    "windows": [{ "label": "main", "title": "PRAXIS · Project Review", "width": 1280, "height": 850, "minWidth": 720, "minHeight": 560 }],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; script-src 'self'; connect-src ipc: http://ipc.localhost",
      "capabilities": ["bootstrap"]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "Understand what your AI-built project actually demonstrates.",
    "resources": { "runtime/": "runtime/" },
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "windows": { "nsis": { "installMode": "currentUser" }, "webviewInstallMode": { "type": "offlineInstaller" } },
    "macOS": { "minimumSystemVersion": "12.0" }
  }
}
