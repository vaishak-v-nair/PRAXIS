{
  "name": "praxis-memory",
  "version": "0.14.0",
  "description": "Your AI says \"done.\" PRAXIS proves it. Signed, tamper-evident receipts of what your coding agent actually did — plus durable project memory. Local-first: no server, no account, your code never leaves your machine.",
  "type": "module",
  "bin": {
    "praxis": "src/cli.js",
    "praxis-memory": "src/cli.js"
  },
  "files": [
    "src",
    "scripts/postinstall.js",
    "apps/workbench",
    "web/live/app.js",
    "web/live/graph.js",
    "web/live/index.html",
    "web/live/style.css",
    "web/receipt/verify.js",
    "start.ps1",
    "README.md",
    "docs/VERIFY-QUICKSTART.md",
    "docs/GITHUB-APP.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "postinstall": "node scripts/postinstall.js",
    "test": "node --test \"test/*.test.js\"",
    "dev": "node src/cli.js workbench",
    "workbench": "node src/cli.js workbench",
    "dev:api": "npm --prefix apps/workbench run dev:api",
    "dev:web": "npm --prefix apps/workbench run dev:web",
    "typecheck:workbench": "npm --prefix apps/workbench run typecheck",
    "build:workbench": "npm --prefix apps/workbench run build",
    "start:workbench": "node src/cli.js workbench --production",
    "test:workbench": "npm --prefix apps/workbench run test:backend",
    "eval:verify": "promptfoo eval -c evals/verify/promptfooconfig.yaml --no-cache && node evals/verify/metrics.mjs",
    "redteam:verify": "promptfoo redteam run -c evals/verify/redteam-config.yaml -o evals/verify/redteam-cases.yaml --no-cache --strict --remote"
  },
  "keywords": [
    "claude-code",
    "claude",
    "codex",
    "agents",
    "receipts",
    "verification",
    "agent-accountability",
    "provenance",
    "mcp",
    "memory",
    "context",
    "ai",
    "cli"
  ],
  "license": "MIT",
  "author": "Vaishak V Nair (https://github.com/vaishak-v-nair)",
  "devDependencies": {
    "@langchain/core": "1.2.12",
    "@langchain/langgraph": "1.4.17",
    "@libsql/client": "0.17.4",
    "ffmpeg-static": "^5.3.0",
    "promptfoo": "0.122.1",
    "sharp": "^0.35.3",
    "three": "0.181.2",
    "zod": "4.6.5"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vaishak-v-nair/PRAXIS.git"
  },
  "homepage": "https://vaishak-v-nair.github.io/PRAXIS",
  "bugs": {
    "url": "https://github.com/vaishak-v-nair/PRAXIS/issues"
  }
}
